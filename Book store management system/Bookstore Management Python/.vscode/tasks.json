{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Run C++",
      "type": "shell",
      "command": "g++",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "-Wl,--subsystem,console"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Compile C++ file using g++ with console flag"
    }
  ]
}
